{
  "name": "dsh-chrome-tab",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Mention a live Chrome tab with @ and let the agent read and drive it.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./extension/*": "./extension/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "bridge.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "extension",
    "mac/axdriver.swift",
    "mac/driver.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "license": "MIT"
}
