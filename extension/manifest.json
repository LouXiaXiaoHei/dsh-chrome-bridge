{
  "manifest_version": 3,
  "name": "DSH Chrome Tab Bridge",
  "version": "0.1.0",
  "description": "Lets DeepSeek Harness read and drive the Chrome tab you mention with @.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage",
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DSH Chrome Tab Bridge",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* http://127.0.0.1:*"
  }
}
